{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://didactum.org/schemas/lesson-package.v1.json",
  "title": "Didactum LessonPackage v1",
  "description": "Renderer-agnostic, TTS-agnostic, coordinate-free lesson. Players decide how it looks and sounds.",
  "type": "object",
  "required": ["schema_version", "id", "slug", "metadata", "problem"],
  "oneOf": [{"required": ["chapters"]}, {"required": ["acts"]}],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80},
    "metadata": {
      "type": "object",
      "required": ["subject", "topic", "concept_slugs", "grade_band", "language", "authors", "license", "never_verbatim_verified"],
      "additionalProperties": false,
      "properties": {
        "subject": {"type": "string", "minLength": 2},
        "topic": {"type": "string", "minLength": 2},
        "concept_slugs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
        "grade_band": {"enum": ["k-2", "3-5", "6-8", "9-12", "college", "adult"]},
        "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "license": {"type": "string", "minLength": 2},
        "never_verbatim_verified": {"type": "boolean"}
      }
    },
    "problem": {
      "type": "object",
      "required": ["statement", "givens", "unknown"],
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 3},
        "givens": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "string", "minLength": 1},
        "param_spec": {"type": "object"},
        "assessment": {
          "type": "object",
          "required": ["answer"],
          "additionalProperties": false,
          "properties": {
            "answer": {"type": "string", "minLength": 1},
            "answer_value": {"type": "string", "minLength": 1},
            "rationale": {"type": "string"}
          }
        }
      }
    },
    "problem_chapter_index": {"type": "integer", "minimum": 0},
    "chapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "acts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "perspectives": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reframed_problem", "beats"],
        "additionalProperties": false,
        "properties": {
          "reframed_problem": {"type": "string"},
          "beats": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {"type": "string"},
                "say": {"type": "string"},
                "label_swaps": {"type": "object", "additionalProperties": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["id", "title", "beats"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "role": {"enum": ["why", "history", "uses", "seek", "how", "check"]},
        "title": {"type": "string", "minLength": 3, "maxLength": 120},
        "skippable": {"type": "boolean"},
        "duration_hint_s": {"type": "integer", "minimum": 1, "maximum": 1800},
        "beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/beat"}}
      }
    },
    "beat": {
      "type": "object",
      "required": ["id", "narration"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "narration": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "word_index"],
                "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "word_index": {"type": "integer", "minimum": 0}}
              }
            },
            "pause_ms": {"type": "integer", "minimum": 0, "maximum": 5000},
            "intent": {"type": "string"}
          }
        },
        "visuals": {"type": "array", "items": {"$ref": "#/$defs/visual"}},
        "checkin": {
          "type": "object",
          "required": ["prompt", "choices"],
          "additionalProperties": false,
          "properties": {
            "prompt": {"type": "string", "minLength": 1},
            "choices": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "hints": {"type": "array", "items": {"type": "string"}},
            "correct_index": {"type": "integer", "minimum": 0}
          }
        },
        "board_ops_compat": {"type": "array", "items": {"type": "object"}}
      }
    },
    "visual": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["fraction_bar", "number_line", "geometry_figure", "coordinate_graph", "equation_steps", "balance_scale", "diagram", "callout", "brace"]},
        "id": {"type": "string"},
        "props": {"type": "object"},
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {"enum": ["full", "left", "right", "top", "bottom", "center"]},
            "emphasis": {"enum": ["low", "normal", "high"]},
            "relative_to": {"type": "string"}
          }
        },
        "reveal_cue": {"type": "string"}
      }
    }
  }
}
